/android
/ios
*.apk
*.aab
*.ipa
*.keystore
!debug.keystore

# ---- EAS ----
credentials.json

# ---- ML models ----
# Large .tflite binaries. Track with git-lfs if they must be versioned;
# otherwise document the download step in docs/ARCHITECTURE.md.
assets/models/*.tflite

# ---- Phase 0 spike artifacts ----
# Reference photos and labeled frame sets are store-specific and large.
spike/frames/
spike/results/
*.sqlite
*.db

# ---- Tooling ----
coverage/
.jest-cache/
.eslintcache

# ---- Claude Code ----
# Shared project config IS committed (.claude/settings.json, commands/, hooks/).
# Personal overrides are not.
.claude/settings.local.json

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

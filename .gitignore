# ---- Environment ----
.env
.env.local
.env.*.local

# ---- Node ----
node_modules/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

# ---- Expo ----
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ---- Native builds ----

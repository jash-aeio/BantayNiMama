# BantayNiMama — environment
#
# ────────────────────────────────────────────────────────────────────────────
#  This app has NO runtime secrets, and that is deliberate.
#
#  There is no backend, no API, no authentication and no cloud service
#  (TR-50). Nothing here is a credential. If you ever find yourself adding an
#  API key to this file, stop — it means a feature has drifted outside the
#  offline-only constraint, and that is a spec violation, not a config need.
# ────────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` (git-ignored). Everything below is build-time or dev-only.
# Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle and is
# therefore readable by anyone with the APK — never put a secret behind it.


# ── Developer diagnostics ───────────────────────────────────────────────────

# Show the per-stage frame timing overlay on the scanner (ms per pipeline step).
# Use this to check the NFR-07 budget on a real device. Off in release builds.
EXPO_PUBLIC_SHOW_PERF_HUD=false

# Log every match decision (top-3 products, similarities, ACCEPT/DISAMBIGUATE/
# UNKNOWN verdict). Very noisy. Essential while calibrating tau and delta.
EXPO_PUBLIC_LOG_MATCHES=false

# Override the matching thresholds for an experiment WITHOUT writing to
# app_meta. Leave empty in normal use — the real values live in the database
# (TR-35, ADR-008), and these exist only so a spike can sweep values quickly.
EXPO_PUBLIC_TAU_OVERRIDE=
EXPO_PUBLIC_DELTA_OVERRIDE=

# Frame processor target FPS. Production is 4 (TR-26). Raise only to measure
# the thermal/battery cost, never to ship.
EXPO_PUBLIC_TARGET_FPS=4


# ── Model selection ─────────────────────────────────────────────────────────

# Which bundled .tflite to load from assets/models/.
# Changing this invalidates every stored vector (TR-23) — the app must
# re-embed from the stored reference JPEGs before matching again.
EXPO_PUBLIC_MODEL_ID=mobilenet_v3_large_embedder_v1


# ── Build identity (EAS) ────────────────────────────────────────────────────
# Not secret. Public identifiers for the build service.

EAS_PROJECT_ID=
